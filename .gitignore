# Python virtual environments. Nothing here needs one -- apply.sh installs the
# controller's dependencies straight into dist/build with pip --target -- but
# earlier revisions of this project did, and a leftover .venv from one of those
# will otherwise be committed wholesale.
.venv/
.venv-*/
__pycache__/
*.pyc

